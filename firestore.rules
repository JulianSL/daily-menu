rules_version = '2';

// Menu Mingguan — one document per family, addressed by a long random family code.
// Anyone who knows the code can read/write that one document; nobody can list
// or delete documents, so codes cannot be discovered by browsing the database.
service cloud.firestore {
  match /databases/{database}/documents {
    match /families/{code} {
      allow get: if code.size() >= 20;
      allow create, update: if code.size() >= 20
        && request.resource.data.keys().hasOnly(['state', 'updatedAt', 'clientId'])
        && request.resource.data.state is string
        && request.resource.data.state.size() < 500000
        && request.resource.data.updatedAt is int;
      allow list, delete: if false;
    }
  }
}
